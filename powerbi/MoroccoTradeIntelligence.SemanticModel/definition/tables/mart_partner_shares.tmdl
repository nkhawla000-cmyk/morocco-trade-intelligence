table mart_partner_shares
	lineageTag: 4b5e1ed8-ca46-5c0f-bbc5-34d64568a56e

	measure 'Part des exportations (top 10)' = ```
			VAR SelectedYear = [Année affichée]
			RETURN
			    CALCULATE (
			        SUM ( mart_partner_shares[share_of_world] ),
			        mart_partner_shares[year] = SelectedYear,
			        mart_partner_shares[flow_code] = "X",
			        mart_partner_shares[partner_rank] <= 10
			    )
			```
		formatString: 0.0%
		lineageTag: 71e98cab-7a80-5c9c-9153-c8695ab12373

	measure 'Part des importations (top 10)' = ```
			VAR SelectedYear = [Année affichée]
			RETURN
			    CALCULATE (
			        SUM ( mart_partner_shares[share_of_world] ),
			        mart_partner_shares[year] = SelectedYear,
			        mart_partner_shares[flow_code] = "M",
			        mart_partner_shares[partner_rank] <= 10
			    )
			```
		formatString: 0.0%
		lineageTag: e20fd3cc-860a-5715-9173-f37b9de0d37a

