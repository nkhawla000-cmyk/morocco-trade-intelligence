table mart_concentration
	lineageTag: fb08757b-567e-5c13-b8ce-d30e4b218bc5

	measure 'HHI exportations' = ```
			CALCULATE ( AVERAGE ( mart_concentration[hhi] ), mart_concentration[flow_code] = "X" )
			```
		formatString: #,0
		lineageTag: f32a2a9e-b483-5193-9f71-ed0745958752

	measure 'HHI importations' = ```
			CALCULATE ( AVERAGE ( mart_concentration[hhi] ), mart_concentration[flow_code] = "M" )
