table mart_partner_segments
	lineageTag: 2b36b1d1-c7cb-5cf9-8337-548ec447e349

	measure 'Part des exportations (moyenne)' = ```
			AVERAGE ( mart_partner_segments[export_share] )
			```
		formatString: 0.0%
		lineageTag: e22e70f1-6679-5d90-9f62-7f6c54b8b1e1

	measure 'Croissance annuelle (moyenne)' = ```
			AVERAGE ( mart_partner_segments[growth_rate] )
			```
		formatString: 0.0%
		lineageTag: add926ea-1a59-598f-9857-c20715691468

	measure 'Commerce moyen (USD)' = ```
			SUM ( mart_partner_segments[exports_avg_usd] ) + SUM ( mart_partner_segments[imports_avg_usd] )
			```
		formatString: #,0
		lineageTag: 7106e685-2e71-5a13-adc4-c952aec8d2e7

	measure 'Partenaires segmentés' = ```
			COUNTROWS ( mart_partner_segments )
			```
