	partition mart_trade_overview = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/nkhawla000-cmyk/morocco-trade-intelligence/main/data/marts/mart_trade_overview.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"year", "exports_usd", "imports_usd", "trade_balance_usd", "coverage_ratio", "exports_growth", "imports_growth", "possible_series_break"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"year", Int64.Type}, {"exports_usd", type number}, {"imports_usd", type number}, {"trade_balance_usd", type number}, {"coverage_ratio", type number}, {"exports_growth", type number}, {"imports_growth", type number}, {"possible_series_break", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
