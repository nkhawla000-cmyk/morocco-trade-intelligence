	partition mart_partner_segments = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/nkhawla000-cmyk/morocco-trade-intelligence/main/data/marts/mart_partner_segments.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"partner_code", "partner_name", "segment_id", "segment_label", "exports_avg_usd", "imports_avg_usd", "log10_trade_usd", "export_share", "growth_rate", "automotive_export_share"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"partner_code", Int64.Type}, {"partner_name", type text}, {"segment_id", Int64.Type}, {"segment_label", type text}, {"exports_avg_usd", type number}, {"imports_avg_usd", type number}, {"log10_trade_usd", type number}, {"export_share", type number}, {"growth_rate", type number}, {"automotive_export_share", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
