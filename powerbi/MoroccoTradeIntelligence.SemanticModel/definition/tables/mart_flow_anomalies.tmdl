	partition mart_flow_anomalies = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/nkhawla000-cmyk/morocco-trade-intelligence/main/data/marts/mart_flow_anomalies.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"year", "flow_code", "partner_code", "partner_name", "previous_value_usd", "trade_value_usd", "change_ratio", "typical_change_ratio", "robust_z", "partners_compared", "is_anomaly"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"year", Int64.Type}, {"flow_code", type text}, {"partner_code", Int64.Type}, {"partner_name", type text}, {"previous_value_usd", type number}, {"trade_value_usd", type number}, {"change_ratio", type number}, {"typical_change_ratio", type number}, {"robust_z", type number}, {"partners_compared", Int64.Type}, {"is_anomaly", type logical}}, "en-US"),
				    Result = Table.SelectRows(Typed, each [is_anomaly] = true)
				in
				    Result

	annotation PBI_ResultType = Table
