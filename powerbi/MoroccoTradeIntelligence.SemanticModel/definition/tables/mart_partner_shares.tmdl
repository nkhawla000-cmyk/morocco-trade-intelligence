	partition mart_partner_shares = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/nkhawla000-cmyk/morocco-trade-intelligence/main/data/marts/mart_partner_shares.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"year", "flow_code", "partner_code", "partner_name", "is_special_area", "trade_value_usd", "world_value_usd", "share_of_world", "partner_rank"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"year", Int64.Type}, {"flow_code", type text}, {"partner_code", Int64.Type}, {"partner_name", type text}, {"is_special_area", type logical}, {"trade_value_usd", type number}, {"world_value_usd", type number}, {"share_of_world", type number}, {"partner_rank", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
