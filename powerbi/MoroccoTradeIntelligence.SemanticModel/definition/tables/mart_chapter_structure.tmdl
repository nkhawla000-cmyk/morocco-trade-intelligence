table mart_chapter_structure
	lineageTag: e4426966-7763-5f0b-ae46-36d9b6059297

	measure 'Part des exportations par chapitre (top 10)' = ```
			VAR SelectedYear = [Année affichée]
			RETURN
			    CALCULATE (
			        SUM ( mart_chapter_structure[share_of_chapters] ),
			        mart_chapter_structure[year] = SelectedYear,
			        mart_chapter_structure[flow_code] = "X",
			        mart_chapter_structure[chapter_rank] <= 10
			    )
			```
		formatString: 0.0%
		lineageTag: 5ffee07f-2359-5b9b-8cc1-af759cfa7555

	measure 'Part des importations par chapitre (top 10)' = ```
			VAR SelectedYear = [Année affichée]
			RETURN
			    CALCULATE (
			        SUM ( mart_chapter_structure[share_of_chapters] ),
			        mart_chapter_structure[year] = SelectedYear,
			        mart_chapter_structure[flow_code] = "M",
			        mart_chapter_structure[chapter_rank] <= 10
			    )
			```
		formatString: 0.0%
		lineageTag: 69ce1a68-0766-545b-aac0-2d205a0a93a4

