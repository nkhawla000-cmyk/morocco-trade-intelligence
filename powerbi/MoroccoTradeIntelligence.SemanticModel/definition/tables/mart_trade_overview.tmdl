table mart_trade_overview
	lineageTag: 30d56294-2be9-5735-9e9c-c1c9f7c4495a

	measure 'Exportations (USD)' = ```
			SUM ( mart_trade_overview[exports_usd] )
			```
		formatString: #,0
		lineageTag: 208d003e-ce41-5fce-ab13-a3cbe1a2a6a4

	measure 'Importations (USD)' = ```
			SUM ( mart_trade_overview[imports_usd] )
			```
		formatString: #,0
		lineageTag: dfdeaa6a-b9e8-5a75-af3b-b8e6f42f1921

	measure 'Solde commercial (USD)' = ```
			SUM ( mart_trade_overview[trade_balance_usd] )
			```
		formatString: #,0
		lineageTag: 57d298d0-e1a6-5945-aea9-b6ae338081cf

	measure 'Dernière année' = ```
			MAX ( mart_trade_overview[year] )
			```
		formatString: 0
		lineageTag: c8cd5766-5678-5c82-bd85-ca75d95b128e

	measure Exportations = ```
			VAR LastYear = MAX ( mart_trade_overview[year] )
			RETURN
			    CALCULATE ( [Exportations (USD)], mart_trade_overview[year] = LastYear )
			```
		formatString: #,0
		lineageTag: 74e05d70-2abc-5ede-a309-9559ada2c6ef

	measure Importations = ```
			VAR LastYear = MAX ( mart_trade_overview[year] )
			RETURN
			    CALCULATE ( [Importations (USD)], mart_trade_overview[year] = LastYear )
			```
		formatString: #,0
		lineageTag: fd3788b3-9471-534d-99ab-e78f3b18a187

	measure 'Solde commercial' = ```
			[Exportations] - [Importations]
			```
		formatString: #,0
		lineageTag: ff454cb8-4750-5f88-9994-427246d5612c

	measure 'Taux de couverture' = ```
			DIVIDE ( [Exportations], [Importations] )
			```
		formatString: 0.0%
		lineageTag: c14727e1-d2dd-5065-a0a9-f8ed676e3682

