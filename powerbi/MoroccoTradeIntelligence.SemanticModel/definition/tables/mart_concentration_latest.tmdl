	partition mart_concentration_latest = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/nkhawla000-cmyk/morocco-trade-intelligence/main/data/marts/mart_concentration.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"year", "flow_code", "cmd_code", "product_description", "scope_label", "partner_count", "total_value_usd", "hhi", "concentration_level", "top_partner_code", "top_partner_name", "top_partner_share", "top5_share"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"year", Int64.Type}, {"flow_code", type text}, {"cmd_code", type text}, {"product_description", type text}, {"scope_label", type text}, {"partner_count", Int64.Type}, {"total_value_usd", type number}, {"hhi", type number}, {"concentration_level", type text}, {"top_partner_code", Int64.Type}, {"top_partner_name", type text}, {"top_partner_share", type number}, {"top5_share", type number}}, "en-US"),
				    Result = Table.SelectRows(Typed, each [year] = List.Max(Typed[year]))
				in
				    Result

	annotation PBI_ResultType = Table
