	partition mart_mirror_gaps = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/nkhawla000-cmyk/morocco-trade-intelligence/main/data/marts/mart_mirror_gaps.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, {"year", "flow_code", "comparison", "counterpart_code", "counterpart_name", "declared_value_usd", "mirror_value_usd", "gap_usd", "gap_ratio", "needs_review"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"year", Int64.Type}, {"flow_code", type text}, {"comparison", type text}, {"counterpart_code", Int64.Type}, {"counterpart_name", type text}, {"declared_value_usd", type number}, {"mirror_value_usd", type number}, {"gap_usd", type number}, {"gap_ratio", type number}, {"needs_review", type logical}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
